# Terraform working directories
**/.terraform/

# State files (state lives in S3, never in git)
*.tfstate
*.tfstate.*

# Plan files
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Variable files with secrets or personal values
# (non-secret environments/*/terraform.tfvars ARE committed)
*.secret.tfvars
secrets.auto.tfvars
bootstrap/terraform.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Generated by examples
inventory.ini

# Debug logs
terraform.log

# OS / editor
.DS_Store
.idea/
.vscode/

# NOTE: commit .terraform.lock.hcl — it pins provider versions
